{
  "name": "node-solana-starter-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "node scripts/sync-abi.mjs --allow-missing",
    "build": "npm run typecheck && vite build",
    "build:no-typecheck": "vite build",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "npm run test:frontend",
    "test:frontend": "node --test-force-exit --import tsx --import ./tests/frontend/support/register.mjs --test $(find tests/frontend -maxdepth 1 -name '*.test.ts') && NAVE_TEST_PROFILE=unconfigured node --test-force-exit --import tsx --import ./tests/frontend/support/register.mjs --test $(find tests/frontend/unconfigured -name '*.test.ts')",
    "lint": "eslint .",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "sync-idl": "node scripts/sync-idl.mjs",
    "sync-abi": "node scripts/sync-abi.mjs",
    "sync-abi:check": "node scripts/sync-abi.mjs",
    "eval:guardrails": "npx -y tsx eval/run-guardrails.ts",
    "eval:decisions": "npx -y tsx eval/run-decisions.ts",
    "eval:ft-scorecard": "npx -y tsx eval/run-ft-scorecard.ts",
    "eval:ft-scorecard:ci": "npx -y tsx eval/run-ft-scorecard.ts --max-signed-bad 0",
    "eval:agent-contracts": "npx -y tsx eval/run-agent-contracts.ts",
    "eval": "npm run eval:agent-contracts && npm run eval:guardrails && npm run eval:decisions",
    "eval:ci": "npm run eval:agent-contracts && npm run eval:guardrails && npm run eval:decisions && npm run eval:ft-scorecard:ci",
    "typecheck:eval": "tsc -p tsconfig.evalcheck.json",
    "trace:export": "npx -y tsx scripts/export-finetune-traces.ts",
    "provision:revenue-atas": "npx -y tsx scripts/provision-revenue-atas.ts",
    "provision:revenue-atas:dry": "npx -y tsx scripts/provision-revenue-atas.ts --dry-run",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy:webhook": "supabase functions deploy helius-webhook",
    "register-webhook": "node scripts/register-helius-webhook.mjs",
    "verify:e2e-gate": "node scripts/verify-e2e-gate.mjs",
    "verify:devnet-multichain": "node scripts/devnet-multichain-verify.mjs",
    "verify:devnet-multichain:evm-indexer": "node scripts/merge-evm-indexer-env.mjs -- npm run verify:devnet-multichain",
    "agentic-e2e:checkpoint": "node scripts/agentic-e2e-checkpoint.mjs",
    "agentic-e2e:preflight": "node scripts/agentic-e2e-checkpoint.mjs preflight",
    "agentic-e2e:forge": "node scripts/agentic-e2e-checkpoint.mjs run-forge",
    "verify:agentic-e2e-suite": "node scripts/agentic-e2e-run-verifiers.mjs",
    "test:devnet:contracts": "node scripts/test-devnet-multichain.mjs --contracts-only --solana-smoke",
    "test:devnet:multichain": "node scripts/test-devnet-multichain.mjs",
    "test:devnet:multichain:strict": "SKIP_E2E_GATE=1 node scripts/test-devnet-multichain.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "beta:go-no-go": "node scripts/beta-go-no-go.mjs",
    "beta:health-report": "node scripts/beta-health-report.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "secrets:sync-edge-rpc": "node scripts/sync-supabase-edge-rpc-secrets.mjs",
    "mainnet:preflight": "node scripts/mainnet-cutover.mjs --phase preflight",
    "mainnet:cutover": "node scripts/mainnet-cutover.mjs",
    "mainnet:verify": "node scripts/mainnet-cutover.mjs --phase verify",
    "mainnet:wizard": "node scripts/mainnet-cutover-wizard.mjs --dry-run",
    "mainnet:wizard:rehearse": "node scripts/mainnet-cutover-wizard.mjs --rehearse-testnet",
    "mainnet:wizard:live": "node scripts/mainnet-cutover-wizard.mjs --live",
    "cutover:base-rh": "node scripts/cutover-base-robinhood.mjs",
    "cutover:base-rh:validate": "node scripts/cutover-base-robinhood.mjs --phase validate",
    "cutover:base-rh:app-env": "node scripts/cutover-base-robinhood.mjs --phase app-env"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@dhiwise/component-tagger": "1.0.15",
    "@hookform/resolvers": "3.9.1",
    "@moonpay/moonpay-react": "1.10.8",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@solana/spl-token": "0.4.13",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.38",
    "@solana/wallet-adapter-wallets": "0.19.36",
    "@solana/web3.js": "1.98.2",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "^5.101.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "12.38.0",
    "input-otp": "^1.4.1",
    "lucide-react": "0.454.0",
    "postprocessing": "^6.39.1",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-day-picker": "8.10.1",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "7.54.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "2.1.7",
    "react-router-dom": "6.22.1",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "three": "^0.184.0",
    "vaul": "0.9.6",
    "viem": "^2.52.2",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "@playwright/test": "^1.52.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react-swc": "4.3.0",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "9.9.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.11",
    "estree-walker": "^3.0.3",
    "globals": "15.9.0",
    "magic-string": "^0.30.21",
    "postcss": "8.4.35",
    "tailwindcss": "3.4.11",
    "tsx": "^4.23.0",
    "typescript": "5.5.3",
    "typescript-eslint": "8.3.0",
    "vite": "8.0.8"
  }
}
