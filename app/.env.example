# ─── Nave frontend environment ───────────────────────────────────────────────
# Copy to `.env.local` (gitignored) and adjust per environment.
# All client-exposed vars MUST be prefixed with VITE_.
# For launch automation inputs, see `.env.mainnet.cutover.example`.

# Solana RPC endpoint the wallet/Anchor clients talk to.
#   localnet:  http://127.0.0.1:8899
#   devnet:    https://your-devnet-rpc-provider.example
#   mainnet:   https://your-mainnet-rpc-provider.example
VITE_SOLANA_RPC_URL=https://your-devnet-rpc-provider.example

# Optional — Etherscan API v2 key for discovering ERC-20 contracts that touched the
# EVM treasury (inbound transfer history merged into the Assets view). Without this,
# the UI still lists registered + allowlisted balances only.
# VITE_ETHERSCAN_API_KEY=

# Render bundled demo data instead of querying the chain. Set to "true" only for
# the marketing/demo lobby; keep "false" for real localnet/devnet usage.
VITE_USE_MOCKS=false
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: show lobby/marketing CTAs that open the bundled demo treasury (MOCK_DAO_ADDRESS).
# Defaults off in production builds; `vite dev` enables without setting this.
# VITE_DEMO_TREASURY_NAV=true

# Supabase project (edge functions + anon key). REQUIRED — the app fails fast at
# boot if these are unset (no baked-in fallback). Provision per environment.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Never expose or commit Supabase secret/service-role keys.
# VITE_SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Program IDs — REQUIRED. The app fails fast at boot if any are unset (no
# hardcoded fallback). Use the canonical Anchor.toml / IDL addresses below, or
# override for a custom deployment.
VITE_NAVE_CORE_PROGRAM_ID=8GSh9ghC2EL88X9FwftiH2QDrm8drvgSLAUoo45gN5nB
VITE_NAVE_GOVERNANCE_PROGRAM_ID=CwFouCjZyBrpLGuKvd9VXQqYh4ZYyT9yUQbqmo6k7n9M
VITE_NAVE_EXECUTION_PROGRAM_ID=2sGy7WwF6uGCyBmPqohRtobmutGhKjr2AG2FKvfcpYzb
VITE_NAVE_JITO_ADAPTER_ID=E2fviyVGWF8iEwZK2M8ysrd63DM5yKxu6nuBMzjBQ2XT
VITE_NAVE_KAMINO_ADAPTER_ID=B69DnA6h7B7MvLkNjRQDs4qDUbw9zrNwF9c8WuKo7kfD
VITE_NAVE_MARGINFI_ADAPTER_ID=Gavh8GezswR14BYC851r6vevk267iWDfBkC3Fo49b1q7

# Jupiter Lend (Earn) program IDs.
# Devnet defaults are built in; override here for mainnet (--features mainnet build):
#   Mainnet lending:   jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9
#   Mainnet liquidity: jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC
VITE_JUPITER_LENDING_PROGRAM_ID=7tjE28izRUjzmxC1QNXnNwcc4N82CNYCexf3k8mw67s3
VITE_JUPITER_LIQUIDITY_PROGRAM_ID=5uDkCoM96pwGYhAUucvCzLfm5UcjVRuxz6gH81RnRBmL

# MarginFi v2 lending program (target of configure_marginfi_position /
# marginfi_deposit / marginfi_withdraw). Devnet default is built in; override
# for mainnet (--features mainnet build): MFv2hWf31Z9kbCa1snEPYctwafyhdvnV7FZnsebVacA
VITE_MARGINFI_PROGRAM_ID=A7vUDErNPCTt9qrB6SSM4F6GkxzUe9d8P3cXSmRg4eY4

# Protocol revenue wallet — receives the PROTOCOL portion of the DAO formation
# fee on-chain (`global_config.treasury`). The formation fee is now SPLIT: the
# protocol portion (mainnet 1.5 SOL / devnet 0) goes here, and the TREASURY-SEED
# portion (mainnet 0.3 SOL / devnet 0.1 SOL) is wrapped to wSOL and seeded into
# the new DAO's own treasury by the unified creation flow (it is NOT charged by
# initialize_dao). Token mint fees (0.5 SOL) accumulate in the protocol_fee_vault
# PDA; sweep those to this wallet manually or via ops scripts. Must match the
# treasury passed to initialize_global_config at deploy time.
VITE_NAVE_PROTOCOL_FEE_WALLET=EJ9qpuQosjwv8N1Rab7SK4zvVpEbvEBbCdum9KseADLn
NAVE_PROTOCOL_FEE_WALLET=EJ9qpuQosjwv8N1Rab7SK4zvVpEbvEBbCdum9KseADLn

# OPTIONAL — posted Pyth SOL/USD PriceUpdateV2 account used to revalue the wSOL
# treasury seed during the unified creation flow (so the new DAO's NAV is priced
# immediately). When UNSET, the creation flow skips the in-wizard revalue and the
# off-chain snapshot/revalue pipeline computes NAV before the first agent
# execution — the wizard does not block on it. Must be a fresh PriceUpdateV2
# account owned by the Pyth receiver program for the SOL/USD feed
# (ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d).
# VITE_SOL_USD_PRICE_UPDATE=

# NAVE stake / bridge foundation.
# Devnet uses the replica mint below; mainnet uses the real NAVE SPL mint.
VITE_SOLANA_NAVE_MAINNET_MINT=EGg56E1YtL5YapzkF7vkRThHR8i5FeRvm2LLuySdYory
VITE_SOLANA_NAVE_DEVNET_MINT=GmBMZuXsXpe7TZK27PTcXUyNGcuw9Ew8v3fxys7wM9Wa
# Optional override for the active Solana NAVE mint; when unset the app selects
# devnet/mainnet from VITE_SOLANA_RPC_URL.
# VITE_SOLANA_NAVE_MINT=
VITE_NAVE_DEVNET_PRICE_USD=10
VITE_NAVE_DAO_CREATION_STAKE_USD=19
# Bridge fee: 2.5% (250 bps) charged ON TOP of the bridged amount, split
# 1% staking / 1% protocol / 0.5% burn (legs must sum to the total or the app
# refuses to boot — mirrors the on-chain validate_fee_config invariant).
VITE_NAVE_BRIDGE_FEE_BPS=250
VITE_NAVE_BRIDGE_STAKING_BPS=100
VITE_NAVE_BRIDGE_PROTOCOL_BPS=100
VITE_NAVE_BRIDGE_BURN_BPS=50
# Wormhole Executor FeeArgs uses tenths of basis points: 2.5% = 2500 dbps.
VITE_NAVE_BRIDGE_FEE_DBPS=2500
# Protocol-revenue wallet (owner of the protocol fee account; display only —
# the on-chain BridgeConfig enforces the real destination).
# VITE_NAVE_BRIDGE_PROTOCOL_WALLET=6N5JiWP2zF6VXhG6hwgYEYhxBEARAV5P6WRgfYb2zskC
# WrappedNave ERC-20 addresses per chain (hardened stack, 2026-07-06 — same
# address on both testnets via matched deployer nonces; freezable/controllable,
# minter = NaveBridge lockbox, supplyCap 100k NAVE). Legacy MVP tokens were
# 0x263d… (Sepolia) / 0xa2DF… (Base Sepolia).
VITE_EVM_SEPOLIA_WRAPPED_NAVE_ADDRESS=0x1d1d988e8ffE542f1f8F7932DE3A634251D4A042
VITE_EVM_BASE_SEPOLIA_WRAPPED_NAVE_ADDRESS=0xC286e67D59F643a725cf4998af6Bb4f8D1354280
# Robinhood Testnet (46630, Arbitrum Nitro L2) — set once the triple is deployed:
VITE_EVM_ROBINHOOD_TESTNET_WRAPPED_NAVE_ADDRESS=0x7860FF876b49a5A992a7F3a4a6043ea57f17eD96
# VITE_EVM_ETHEREUM_WRAPPED_NAVE_ADDRESS=
# Mainnet Base + Robinhood: SINGLE shared wNAVE (immutable v1 token). Do not
# point these at a parallel second wNAVE. Burns always use this token; Solana→EVM
# mints follow on-chain minter() (v1 lockbox until Safe rotates to v2).
VITE_EVM_BASE_WRAPPED_NAVE_ADDRESS=0xFc04710C3F310f6ed84b441cf897a05807312358
VITE_EVM_ROBINHOOD_WRAPPED_NAVE_ADDRESS=0xFc04710C3F310f6ed84b441cf897a05807312358
# NaveBridge lockbox addresses per chain (sole wNAVE minter: pause + per-tx +
# daily caps + replay guard; see contracts/evm/deployments/hardened-bridge-*.json).
VITE_EVM_SEPOLIA_BRIDGE_LOCKBOX_ADDRESS=0xd5695B76602A288090f3a630dfBca23912cff76d
VITE_EVM_BASE_SEPOLIA_BRIDGE_LOCKBOX_ADDRESS=0x5Cfb00D412a4963b318e9706EB055C706B44cfF6
# VITE_EVM_ROBINHOOD_TESTNET_BRIDGE_LOCKBOX_ADDRESS=
# VITE_EVM_ETHEREUM_BRIDGE_LOCKBOX_ADDRESS=
# Preferred v2 UUPS lockboxes (shared wNAVE). Keep V1 lockbox envs until minter rotation.
VITE_EVM_BASE_BRIDGE_LOCKBOX_ADDRESS=0x4C06d8b71C16428D828F8d5bd05e21E0D1d81573
VITE_EVM_ROBINHOOD_BRIDGE_LOCKBOX_ADDRESS=0xD6d361Cd70FCD82802646aA90c0BA2D6EDA5Bd71
VITE_EVM_BASE_BRIDGE_LOCKBOX_V1_ADDRESS=0x608c6Ee3d56C4Ac5241D5481E72bD236C5404654
VITE_EVM_ROBINHOOD_BRIDGE_LOCKBOX_V1_ADDRESS=0x608c6Ee3d56C4Ac5241D5481E72bD236C5404654
# NaveStaking mirror addresses per chain (stake wNAVE, earn wNAVE rewards).
# Rolling-365d drip pools (redeployed 2026-07-06; the pre-drip pool was
# 0x72939965d3ebb3D13be7C853B6DB6B19150c35b3 on both chains).
VITE_EVM_SEPOLIA_STAKING_ADDRESS=0x9BdE2F925fb71bDfC3EA0F0F9617786b5a642F02
VITE_EVM_BASE_SEPOLIA_STAKING_ADDRESS=0x7860FF876b49a5A992a7F3a4a6043ea57f17eD96
# VITE_EVM_ROBINHOOD_TESTNET_STAKING_ADDRESS=
# VITE_EVM_ETHEREUM_STAKING_ADDRESS=
VITE_EVM_BASE_STAKING_ADDRESS=0x18E8F7b1c313D53FFC35b2b59F25Fada3B9CE5B2
VITE_EVM_ROBINHOOD_STAKING_ADDRESS=0x4C06d8b71C16428D828F8d5bd05e21E0D1d81573
#
# Hardened single-signature bridge (Solana <-> Sepolia / Base Sepolia). The
# Bridge page stays disabled unless BOTH the relayer URL and the Solana custody
# below are set. The lock goes through the nave_bridge program (recipient
# embedded in the one signed tx, fee resolved on-chain); the relayer only
# executes the far side — the browser sends NO relayer secret and NO extra
# message signature.
# Devnet: set to https://nave-server-production.up.railway.app
VITE_NAVE_BRIDGE_RELAYER_URL=https://nave-server-production.up.railway.app
# nave_bridge program id (custody/config PDAs derive from it).
# VITE_NAVE_BRIDGE_PROGRAM_ID=Fu3ZpX1SMvqVhuo7E4uKGvJxe6cJDFDxxmSCET6de9u6
# nave_staking program id (central Solana reward pool for the Stake page).
# VITE_NAVE_STAKING_PROGRAM_ID=AxVdBgc8eUZ3VXKCCJxF7mAmRAtvtM2eYAbE3XBjnhjf
# Solana fee destinations the lock instruction routes fee legs to:
# VITE_NAVE_BRIDGE_PROTOCOL_FEE_ACCOUNT=   # protocol-revenue NAVE token account
# VITE_NAVE_BRIDGE_STAKING_POOL_ACCOUNT=   # staking 1% leg destination — the neutral
#                                          # relayer-owned COLLECTOR account (the staking
#                                          # mirror drips it to all chains), NOT the
#                                          # pool reward vault
# Legacy custody token account (pre-program MVP; kept for bridge-enabled gate).
VITE_NAVE_BRIDGE_SOLANA_CUSTODY=9KTuzRJdDs59KU5UXNXdTQrPznEiiz4URk29NC3PkK5Q
# Solana fee wallet display hint (legacy).
VITE_NAVE_BRIDGE_FEE_PAYEE_SOLANA=EJ9qpuQosjwv8N1Rab7SK4zvVpEbvEBbCdum9KseADLn

# ─── Central NAVE price oracle (Phase 2) ──────────────────────────────────────
# The app + transaction builders read ONE canonical NAVE/USD creation price from
# the `nave-price-oracle` edge function. Browser-side keys (VITE_) below; the
# server-side NAVE_ORACLE_* keys are documented in the server-secrets section.
#
# Optional explicit endpoint override. When unset the client calls
# `${VITE_SUPABASE_URL}/functions/v1/nave-price-oracle`.
# VITE_NAVE_ORACLE_ENDPOINT=
# NAVE token base-unit precision used to convert USD -> NAVE base units (u64).
VITE_NAVE_ORACLE_NAVE_DECIMALS=6
# Forming a treasury does not lock NAVE. Leave the creation-stake USD unset.
# VITE_NAVE_ORACLE_STAKE_USD=

# OPTIONAL — whether the redeployed nave_execution + nave_core programs that
# support the one-time founder BOOTSTRAP path are live on this network.
# Default (unset/false): the client emits the LEGACY create_execution_request
# shape (no `bootstrap` arg / extra program accounts) so normal strategy
# execution keeps working against the currently-deployed programs, and the
# unified-creation wizard skips the immediate auto-activation step. Set to
# "true" ONLY AFTER redeploying nave_execution + nave_core with the bootstrap
# instructions (create_execution_request bootstrap arg + record_bootstrap_usage).
# VITE_NAVE_BOOTSTRAP_DEPLOYED=false

# Optional public site origin for DAO short links (defaults to window.location.origin).
# VITE_APP_ORIGIN=https://nave.finance

# Distinct strategy-escrow PDA toggle. Enabled by default for devnet beta (real SPL
# movement vault → escrow). Set to "false" only for legacy deployments where
# adapters still require strategy_escrow == vault_token_account.
VITE_ESCROW_PDA_ENABLED=true

# ─── EVM (Ethereum + Base) — OPTIONAL ─────────────────────────────────────────
# All EVM vars are optional: a Solana-only build boots without them. EVM support
# activates per-chain only once the Factory + Protocol addresses are supplied.
# Supported chains are restricted to Ethereum (1 / Sepolia 11155111) and Base
# (8453 / Base Sepolia 84532), and Robinhood Chain (4663 / Robinhood Testnet
# 46630) for DAO treasuries + bridge/stake.
# Robinhood Chain (4663 / Robinhood Testnet 46630, Arbitrum Nitro L2). There is
# NO support for any other EVM chain.

# Which EVM environment to wire:
#   "testnet" (default) → Sepolia + Base Sepolia + Robinhood Testnet
#   "mainnet"           → Ethereum + Base + Robinhood mainnets
#   "mixed"             → Ethereum Sepolia + Base Mainnet + Robinhood Mainnet
#                         (Solana stays on VITE_SOLANA_RPC_URL — use Devnet)
# Prefer the Base+Robinhood cutover profile via DEPLOYMENT_DATA.md:
#   npm run cutover:base-rh -- --phase app-env
# VITE_EVM_NETWORK=mixed

# WalletConnect Cloud project id for RainbowKit connectors. REQUIRED whenever
# EVM support is enabled (i.e. any EVM Factory address below is set) — the app
# fails fast at boot without it. There is NO fake/default fallback. Get a real
# project id at https://cloud.walletconnect.com. (A Solana-only build that sets
# no EVM Factory address can leave this unset.)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Per-chain RPC URL overrides.
#   • Testnet (Sepolia / Base Sepolia): optional — falls back to viem public RPC.
#   • MAINNET (Ethereum 1 / Base 8453): REQUIRED for any chain whose Factory is
#     configured. The app fails fast at boot if a configured mainnet chain has
#     no RPC URL — there is NO public-RPC fallback on mainnet (rate-limited /
#     unreliable for production reads + writes). Use a dedicated provider URL.
# VITE_EVM_ETHEREUM_RPC_URL=
# VITE_EVM_BASE_RPC_URL=
# VITE_EVM_ROBINHOOD_RPC_URL=
VITE_EVM_SEPOLIA_RPC_URL=https://sepolia.drpc.org
VITE_EVM_BASE_SEPOLIA_RPC_URL=https://base-sepolia.drpc.org
# Robinhood public RPC (the app also falls back to this automatically). These
# VITE_ URLs ship in the browser bundle — PUBLIC endpoints only, NEVER a
# secret-keyed provider URL (keyed Alchemy URLs stay server-side).
# VITE_EVM_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# NaveProtocol singleton address per chain.
# Testnet values below are the pinned deployments (the app ignores hosted
# overrides for these chains — a stale override was rejecting createDao).
# Mainnet addresses are read from the environment and have no fallback.
# VITE_EVM_ETHEREUM_PROTOCOL_ADDRESS=
# VITE_EVM_BASE_PROTOCOL_ADDRESS=
# VITE_EVM_ROBINHOOD_PROTOCOL_ADDRESS=
VITE_EVM_SEPOLIA_PROTOCOL_ADDRESS=0x8D6dFa14Ac28077E3C746C10Fb40C0C424f848D1
VITE_EVM_BASE_SEPOLIA_PROTOCOL_ADDRESS=0xF37271a4A120eD904543bbE648D2f64Fa27b3bC6
VITE_EVM_ROBINHOOD_TESTNET_PROTOCOL_ADDRESS=0xcA99d4A75A41C3aff5F3Fc2c2Dfd241129B1e093
VITE_EVM_ARC_TESTNET_PROTOCOL_ADDRESS=0x3334fBe32eEe1F9f34C047d90762b3030B5Fe255

# NaveDAOFactory singleton address per chain (optional). Presence of a factory
# address for an active chain flips EVM_ENABLED on for that network.
# VITE_EVM_ETHEREUM_FACTORY_ADDRESS=
# VITE_EVM_BASE_FACTORY_ADDRESS=
# VITE_EVM_ROBINHOOD_FACTORY_ADDRESS=
VITE_EVM_SEPOLIA_FACTORY_ADDRESS=0x4F01c9616A48F14009EC083Ff4bb6e47EdDE0890
VITE_EVM_BASE_SEPOLIA_FACTORY_ADDRESS=0xF53dE95ae1Fed92FFd9C9305E1716FD48EFcB776
VITE_EVM_ROBINHOOD_TESTNET_FACTORY_ADDRESS=0x303cE551De723cad43e1575C4D981C0E2b662b7F
VITE_EVM_ARC_TESTNET_FACTORY_ADDRESS=0xa7bd919a5249DD1Da6E02a6716D2Db2B2e0A99f0
# EVM strategy adapter addresses — the "flip to mainnet" checklist for each
# protocol per chain. This is the SAME env-var naming `src/lib/strategyReadinessData.mjs`
# and `scripts/mainnet-cutover.mjs` both read, so the mainnet cutover fails
# closed on launch if one of these is required (per that registry) and left
# unset. Sepolia Aave/Compound and Base Sepolia Aave point at adapters approved
# on the protocols above. Balancer stays unset on testnets.
# Aave V3:
# VITE_EVM_ETHEREUM_AAVE_ADAPTER_ADDRESS=
# VITE_EVM_BASE_AAVE_ADAPTER_ADDRESS=
VITE_EVM_SEPOLIA_AAVE_ADAPTER_ADDRESS=0xA9183aB50EB70f5F271faB81E50b61a5B11b0a4B
VITE_EVM_BASE_SEPOLIA_AAVE_ADAPTER_ADDRESS=0xcA99d4A75A41C3aff5F3Fc2c2Dfd241129B1e093
# Compound V3 — no official Base Sepolia Comet deployment; leave that one unset:
# VITE_EVM_ETHEREUM_COMPOUND_ADAPTER_ADDRESS=
# VITE_EVM_BASE_COMPOUND_ADAPTER_ADDRESS=
VITE_EVM_SEPOLIA_COMPOUND_ADAPTER_ADDRESS=0xa675dC4A02304ce069D98760DcF64B0cf3530A80
# VITE_EVM_BASE_SEPOLIA_COMPOUND_ADAPTER_ADDRESS=
# Balancer — mainnet/Base mainnet supported once deployed; both testnets are
# marked unsupported in strategyReadinessData.mjs until a concrete pool
# tuple is validated (setting these before then will FAIL mainnet cutover):
# VITE_EVM_ETHEREUM_BALANCER_ADAPTER_ADDRESS=
# VITE_EVM_BASE_BALANCER_ADAPTER_ADDRESS=
# VITE_EVM_SEPOLIA_BALANCER_ADAPTER_ADDRESS=
# VITE_EVM_BASE_SEPOLIA_BALANCER_ADAPTER_ADDRESS=

# Capital bridge adapters (treasury bridge-out — not $NAVE lockbox):
# VITE_EVM_ROBINHOOD_ARBITRUM_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_ROBINHOOD_TESTNET_ARBITRUM_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_ETHEREUM_CCTP_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_BASE_CCTP_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_ROBINHOOD_CCTP_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_ETHEREUM_OP_BRIDGE_ADAPTER_ADDRESS=
# VITE_EVM_BASE_OP_BRIDGE_ADAPTER_ADDRESS=
# Arc Testnet (5042002). Do not add Arc mainnet 5042.
# Circle's public endpoint. rpc.testnet.arc.network does not resolve.
VITE_EVM_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
VITE_EVM_ARC_TESTNET_CCTP_BRIDGE_ADAPTER_ADDRESS=0x1b591C6a976e75F65F54cE863C8d96b3289BBF80

# Per-DAO protocol-revenue wallet for EVM DAO creation (optional). PRODUCT
# DECISION: set this to a Nave-controlled EVM fee wallet to mirror Solana, where
# protocol revenue accrues to the Nave treasury (NOT the founder). When unset,
# DAO creation falls back to the founder address. (Performance fees default to 0
# in the create flow, so this wallet receives nothing until they're enabled.)
# VITE_EVM_PROTOCOL_REVENUE_WALLET=

# ─── Server-side secrets (NOT exposed to the browser; no VITE_ prefix) ────────
# These are consumed by the signer service and Supabase edge functions. Set them
# in each runtime's secret store (Railway vars / `supabase secrets set`), NOT in
# the committed .env. Listed here only to document what must be provisioned.
#
# Shared bearer secrets (rotate on a schedule; see docs/SECRETS.md):
#   NAVE_INDEXER_SECRET=
#   NAVE_SIGNER_SECRET=
#   NAVE_AGENT_SECRET=
#
# Envelope-encryption master key for agent key custody (base64 32 bytes):
#   openssl rand -base64 32
#   NAVE_MASTER_KEK=...        # wraps per-DAO/per-role agent DEKs; set in edge + signer env
#
# CORS allow-list for edge functions (comma-separated origins). When unset the
# functions fall back to permissive `*` — set this in production:
#   NAVE_ALLOWED_ORIGINS=https://nave.finance,https://app.nave.finance
#
# Central NAVE price oracle (nave-price-oracle edge function). Devnet/testnet
# return a FIXED price; mainnet samples live NAVE markets and fails closed when
# too few healthy samples survive. All keys are clearly namespaced NAVE_ORACLE_*.
#   # Forming a treasury does not lock NAVE. Leave the creation-stake USD unset.
#   # NAVE_ORACLE_STAKE_USD=
#   NAVE_ORACLE_DEVNET_PRICE_USD=10          # fixed NAVE/USD off mainnet
#   NAVE_ORACLE_NAVE_DECIMALS=6              # NAVE mint precision (base-unit conversion)
#   NAVE_ORACLE_QUOTE_TTL_SECONDS=300        # attestation validity window
#   NAVE_ORACLE_QUOTE_TOLERANCE_BPS=100      # downward tolerance for the on-chain min-NAVE floor
#   NAVE_ORACLE_MAINNET_MINT=EGg56E1YtL5YapzkF7vkRThHR8i5FeRvm2LLuySdYory
#   NAVE_ORACLE_DEVNET_MINT=GmBMZuXsXpe7TZK27PTcXUyNGcuw9Ew8v3fxys7wM9Wa
#   # HMAC key that signs price attestations so a stake amount is provable:
NAVE_ORACLE_ATTESTATION_SECRET=your-nave-oracle-attestation-secret
#   # Mainnet aggregation guardrails:
#   NAVE_ORACLE_MIN_LIQUIDITY_USD=25000      # drop pools thinner than this
#   NAVE_ORACLE_MAX_PRICE_AGE_SECONDS=900    # drop samples older than this
#   NAVE_ORACLE_MIN_SOURCES=1                # fail closed below this many healthy samples
#   # Mainnet NAVE market pools (GeckoTerminal pool addresses) + the NAVE token
#   # address on each chain so the oracle can pick the NAVE side of the pool:
#   NAVE_ORACLE_SOLANA_POOL=                 # GeckoTerminal Solana (Meteora) pool address
#   NAVE_ORACLE_SOLANA_TOKEN=                # defaults to the active NAVE mint
#   NAVE_ORACLE_ETHEREUM_POOL=
#   NAVE_ORACLE_ETHEREUM_TOKEN=              # wrapped NAVE ERC-20 (Ethereum)
#   NAVE_ORACLE_BASE_POOL=
#   NAVE_ORACLE_BASE_TOKEN=                  # wrapped NAVE ERC-20 (Base)
#   # Optional direct Meteora DLMM pair (sampled in addition to GeckoTerminal):
#   NAVE_ORACLE_METEORA_POOL=
#   NAVE_ORACLE_METEORA_API_URL=https://dlmm-api.meteora.ag
#
# Signer-side escrow toggle (must match VITE_ESCROW_PDA_ENABLED; default true):
#   NAVE_ESCROW_PDA_ENABLED=true
#
# Jupiter Lend API key (required by signer + worker for CPI account resolution
# and live yield rates). Provision in Railway vars and Supabase edge secrets:
#   JUPITER_API_KEY=...
#
# Jupiter program IDs for signer (devnet defaults; override for mainnet):
#   JUPITER_LENDING_PROGRAM_ID=7tjE28izRUjzmxC1QNXnNwcc4N82CNYCexf3k8mw67s3
#   JUPITER_LIQUIDITY_PROGRAM_ID=5uDkCoM96pwGYhAUucvCzLfm5UcjVRuxz6gH81RnRBmL
#
# MarginFi v2 program ID for signer (marginfi_deposit/marginfi_withdraw CPI;
# devnet default built in, override for mainnet):
#   MARGINFI_PROGRAM_ID=A7vUDErNPCTt9qrB6SSM4F6GkxzUe9d8P3cXSmRg4eY4
#
# Jito Bundle support via Helius (atomic multi-protocol rebalancing + MEV protection).
# Uses the sendBundle JSON-RPC method on the Helius RPC endpoint (same as SOLANA_RPC_URL).
# On devnet/localnet the signer automatically falls back to sequential submission.
#   JITO_TIP_LAMPORTS=5000          # SOL tip per bundle (higher = more likely to land)
#   JITO_BUNDLE_REBALANCE_ENABLED=true  # set false to disable bundle submission globally
#
# Agent swap capability (signer `jupiter_swap` action — off-chain Jupiter
# swap/aggregator route + signer submit; distinct from Jupiter Lend above).
# FAIL-CLOSED: disabled unless explicitly "true". The DAO creation/bootstrap
# flow does NOT depend on this (bootstrap first action is SOL->Jito); this only
# enables agents to swap tokenA->tokenB (e.g. wSOL->USDC) once rolled out.
#   NAVE_SWAP_ENABLED=false             # gate only; the action currently returns 501 (blind-signing
#                                       # Jupiter /swap path removed pending the on-chain jupiter_swap CPI)
#   NAVE_SWAP_MAX_SLIPPAGE_BPS=1000     # cap on per-swap slippage bound (bps; default 1000 = 10%)
#
# Scheduler/worker (signer-service `npm run worker`) — replaces curl-based ops.
# Reuses NAVE_AGENT_SECRET (orchestrator) and NAVE_INDEXER_SECRET (snapshot):
#   SUPABASE_URL=...                 # project URL the worker calls
#   SUPABASE_SERVICE_ROLE_KEY=...    # edge auth for orchestrator/snapshot
#   ORCHESTRATOR_INTERVAL_MS=60000   # poll cadence (default 60s)
#   SNAPSHOT_INTERVAL_MS=900000      # snapshot cadence (default 15m)
#
# Hardened bridge relayer (signer-service `/bridge-relay`). Browser-side config
# is VITE_NAVE_BRIDGE_* above; these are server-only:
#   NAVE_CLUSTER=devnet                   # localnet|devnet|mainnet; mainnet hard-disables the faucet,
#                                         # refuses the localhost RPC default, flags devnet program ids on /health
#   NAVE_EVM_NETWORK=testnet              # mainnet|testnet — the ONLY resolver for legacy chain FAMILY names
#                                         # ('base'/'ethereum'/'robinhood'); unset => family names rejected,
#                                         # callers must send numeric destChainId/sourceChainId
#   BRIDGE_EVM_CHAIN_IDS=                 # optional comma-separated allow-list; default = all chains on NAVE_EVM_NETWORK
#   TRUSTED_PROXY_HOPS=1                  # trusted reverse-proxy hops (Railway=1); req.ip = rightmost untrusted XFF hop
#   BRIDGE_RELAYER_ENABLED=true
#   BRIDGE_SOLANA_NAVE_MINT=              # NAVE mint (see VITE_SOLANA_NAVE_DEVNET_MINT)
#   BRIDGE_SOLANA_BRIDGE_PROGRAM=         # nave_bridge program id (PDAs derive from it)
#   BRIDGE_SOLANA_RELAYER_AUTHORITY=      # relayer keypair (BridgeConfig.relayer); KMS on mainnet
#   BRIDGE_SOLANA_PROTOCOL_FEE_ACCOUNT=   # protocol-revenue NAVE token account (1% leg)
#   BRIDGE_SOLANA_STAKING_POOL_ACCOUNT=   # staking 1% leg destination. With the staking
#                                         # mirror enabled, point this at the COLLECTOR
#                                         # (BRIDGE_SOLANA_STAKING_COLLECTOR) instead of the
#                                         # reward vault — flipped at deploy time.
#   BRIDGE_SOLANA_PROTOCOL_WALLET=6N5JiWP2zF6VXhG6hwgYEYhxBEARAV5P6WRgfYb2zskC
#   BRIDGE_EVM_MINTER_PRIVATE_KEY=        # relayer EOA calling lockbox bridgeIn; KMS on mainnet
#   BRIDGE_EVM_LOCKBOX_11155111=          # NaveBridge lockbox on Sepolia (sole wNAVE minter)
#   BRIDGE_EVM_LOCKBOX_84532=             # NaveBridge lockbox on Base Sepolia
#   BRIDGE_EVM_LOCKBOX_46630=             # NaveBridge lockbox on Robinhood Testnet
#   Mainnet shared wNAVE (single token) + v2 lockbox; keep V1 lockbox until Safe rotates minter:
#   BRIDGE_EVM_WRAPPED_NAVE_8453=0xFc04710C3F310f6ed84b441cf897a05807312358
#   BRIDGE_EVM_WRAPPED_NAVE_4663=0xFc04710C3F310f6ed84b441cf897a05807312358
#   BRIDGE_EVM_LOCKBOX_8453=0x4C06d8b71C16428D828F8d5bd05e21E0D1d81573
#   BRIDGE_EVM_LOCKBOX_4663=0xD6d361Cd70FCD82802646aA90c0BA2D6EDA5Bd71
#   BRIDGE_EVM_LOCKBOX_V1_8453=0x608c6Ee3d56C4Ac5241D5481E72bD236C5404654
#   BRIDGE_EVM_LOCKBOX_V1_4663=0x608c6Ee3d56C4Ac5241D5481E72bD236C5404654
#   BRIDGE_EVM_STAKING_8453=0x18E8F7b1c313D53FFC35b2b59F25Fada3B9CE5B2
#   BRIDGE_EVM_STAKING_4663=0x4C06d8b71C16428D828F8d5bd05e21E0D1d81573
#   BRIDGE_EVM_WRAPPED_NAVE_11155111=     # WrappedNave address on Sepolia (burn events)
#   BRIDGE_EVM_WRAPPED_NAVE_84532=        # WrappedNave address on Base Sepolia
#   BRIDGE_EVM_WRAPPED_NAVE_46630=        # WrappedNave address on Robinhood Testnet
#   Chain-aware reorg guard before Solana release (verifier + watcher). Safe defaults:
#   Ethereum 1/11155111 = 12, Base 8453/84532 = 30, Robinhood 4663/46630 = 60.
#   BRIDGE_EVM_CONFIRMATIONS_<chainId> is the authoritative per-chain override; the legacy
#   global BRIDGE_EVM_CONFIRMATIONS is only a FLOOR (can deepen, never shallow, a chain default).
#   BRIDGE_EVM_CONFIRMATIONS_1=12
#   BRIDGE_EVM_CONFIRMATIONS_8453=30
#   BRIDGE_EVM_CONFIRMATIONS_4663=60
#   BRIDGE_EVM_CONFIRMATIONS=             # legacy global floor (unset = chain defaults)
#   BRIDGE_LOOKBACK_SECONDS=7200          # watcher missed-event lookback (seconds; converted to blocks per chain)
#   BRIDGE_WATCHER_EVM_LOOKBACK_BLOCKS=   # legacy floor in blocks (optional)
#   BRIDGE_FEE_BPS=250                    # 2.5% on-top fee (must match VITE_NAVE_BRIDGE_FEE_BPS)
#
# Staking global-parity mirror (signer-service worker tick, stakingMirror.ts).
# Splits the bridge's 1% staking-fee collector across the Solana + EVM staking
# drip pools by live stake weight. Reuses the bridge relayer keys/RPCs above:
#   STAKING_MIRROR_ENABLED=false          # master switch (tick no-ops unless "true")
#   BRIDGE_SOLANA_STAKING_COLLECTOR=      # neutral relayer-owned NAVE token account
#                                         # receiving the 1% staking leg
#   BRIDGE_SOLANA_STAKING_PROGRAM=AxVdBgc8eUZ3VXKCCJxF7mAmRAtvtM2eYAbE3XBjnhjf
#   BRIDGE_EVM_STAKING_11155111=          # NaveStaking on Sepolia (relayer EOA = rewarder)
#   BRIDGE_EVM_STAKING_84532=             # NaveStaking on Base Sepolia
#   STAKING_MIRROR_MIN_RAW=1000000        # min collector balance before distributing (1 NAVE)
#   STAKING_MIRROR_SRC_CHAIN_ID=901       # lockbox replay-key partition for mirror mints (bridge=900)
#   STAKING_MIRROR_INTERVAL_MS=600000     # worker cadence (10m)
#   STAKING_MIRROR_EVM_LOOKBACK_BLOCKS=5000  # Staked/Unstaked audit-mirror scan window
#
# Devnet faucet (signer-service `/faucet-claim` for NAVE and `/faucet-claim-sol`
# for SOL) — one dedicated funded wallet dispenses both assets, separate from
# the bridge custody authority and the deploy/ops wallet:
#   FAUCET_ENABLED=true                  # gates BOTH the NAVE and SOL claims
#   FAUCET_NAVE_MINT=                   # devnet NAVE mint
#   FAUCET_WALLET_SECRET=                # faucet wallet secret key (base64/base58/JSON array)
#   FAUCET_CLAIM_AMOUNT_NAVE=0.1         # NAVE sent per claim
#   FAUCET_SOL_CLAIM_AMOUNT_SOL=0.05     # devnet SOL sent per SOL claim
#   FAUCET_MIN_SOL_BALANCE=0.01          # NAVE claim only: recipient must already hold this much devnet SOL
#   FAUCET_CLAIM_COOLDOWN_HOURS=24       # dual-enforced per asset: per recipient address AND per caller IP
#
# ─── Nave Pay payment addresses (optional) ───
# Leave these unset until a NavePaymentRouter is deployed on that chain and a
# USDC mint is known. Invoices then show the treasury's canonical address and
# a reference code. They do not invent a forwarder.
#   VITE_PAY_SOLANA_USDC_MINT=          # SPL mint. When set, the invoice also stores that ATA.
#   VITE_PAY_EVM_ROUTERS=               # JSON object of chain id -> router address
#   VITE_PAY_EVM_USDC=                  # JSON object of chain id -> USDC token, used only with a router
#
# Signer crank (also optional; absent config does not broadcast):
#   NAVE_PAY_SOLANA_PROGRAM_ID=
#   NAVE_PAY_ROUTERS=                   # JSON object of chain id -> router address
#   NAVE_PAY_USDC_MINTS=                # JSON object, "solana" and chain ids
#   NAVE_PAY_SETTLE_INTERVAL_MS=600000
# Subscription USDC is sent to the protocol fee wallet unless these are set.
# The same addresses must be available to the pay-claim function as
# PAY_BILLING_SOLANA / PAY_BILLING_EVM (or NAVE_PROTOCOL_FEE_WALLET / EVM_PROTOCOL_REVENUE_WALLET).
#   VITE_PAY_BILLING_SOLANA=
#   VITE_PAY_BILLING_EVM=
#
# ─── Agentic E2E / npm script verifiers (often duplicated in `.env.local`) ───
# `npm run verify:agentic-e2e-suite` loads `.env.local` then runs gate + multichain + forge.
# `npm run verify:e2e-gate` — server-side names (not VITE_*); scripts also accept:
#   VITE_SUPABASE_URL as SUPABASE_URL, VITE_SOLANA_RPC_URL as SOLANA_RPC_URL, and
#   daoAddresses.solana from test-results/agentic-e2e-state.json when DAO_ADDRESS is unset.
#   SUPABASE_URL=                    # optional if VITE_SUPABASE_URL is set
#   SUPABASE_SERVICE_ROLE_KEY=       # service role; same family as edge secrets above
#   DAO_ADDRESS=                     # Solana DAO pubkey for the gate; or checkpoint `set-dao solana`
#   SOLANA_RPC_URL=                  # optional; reconciliation reads (often same as VITE_SOLANA_RPC_URL)
#   NAVE_CORE_PROGRAM_ID=            # optional; script has a devnet default
#   PROTOCOL_IDS=                    # optional; comma-separated (e.g. kamino,jito)
#
# `npm run verify:devnet-multichain` — optional RPC names aligned with evm-indexer / register-dao;
# scripts also accept VITE_EVM_SEPOLIA_RPC_URL / VITE_EVM_BASE_SEPOLIA_RPC_URL when the non-VITE names are unset.
#   EVM_SEPOLIA_RPC_URL=
#   EVM_BASE_SEPOLIA_RPC_URL=
