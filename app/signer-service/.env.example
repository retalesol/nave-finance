# ─── Nave Signer Service configuration ───────────────────────────────────────

# RPC endpoint (localnet for dev, Helius for devnet/mainnet).
# The localhost default is ONLY honored for local/localnet development: the
# service refuses to boot without an explicit SOLANA_RPC_URL when
# NODE_ENV=production or NAVE_CLUSTER is mainnet/devnet.
SOLANA_RPC_URL=http://localhost:8899

# Solana cluster label (localnet | devnet | mainnet). Drives mainnet-only
# guards (faucet hard-off, localhost-RPC refusal, devnet-program-id warnings on
# /health). Reported on /health.
# NAVE_CLUSTER=devnet

# Number of trusted reverse-proxy hops in front of the service (Railway edge =
# 1). Express derives req.ip (rate-limit key) from the RIGHTMOST untrusted
# X-Forwarded-For hop, so callers cannot spoof it. 0 = trust no proxy.
# TRUSTED_PROXY_HOPS=1

# Directory holding the Anchor IDL JSON files (defaults to ../src/idl).
# IDL_DIR=/absolute/path/to/nave-app/src/idl

# Supabase service-role access — used to read encrypted_agent_keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that callers (agent-orchestrator) must present in X-Signer-Secret.
NAVE_SIGNER_SECRET=

# Port to listen on.
PORT=8787

# Optional: program ID overrides (defaults to canonical Anchor.toml IDs).
# NAVE_CORE_PROGRAM_ID=
# NAVE_GOVERNANCE_PROGRAM_ID=
# NAVE_EXECUTION_PROGRAM_ID=
# NAVE_JITO_ADAPTER_ID=
# NAVE_KAMINO_ADAPTER_ID=
# NAVE_MARGINFI_ADAPTER_ID=

# Protocol revenue wallet (2 SOL DAO formation fee). Informational for ops/logging.
# NAVE_PROTOCOL_FEE_WALLET=

# ─── EVM (secp256k1 + EIP-712) signing — Ethereum + Base only ────────────────
# Master KEK used to unwrap EVM agent/guardian DEKs in encrypted_evm_keys. Kept
# DISTINCT from the Solana NAVE_MASTER_KEK. Base64-encoded 32 bytes. Used by
# the /sign-evm endpoint. Outside production it MAY fall back to NAVE_MASTER_KEK;
# with NODE_ENV=production the fallback is disabled and the service refuses to
# boot unless this is set (and decodes to 32 bytes) whenever NAVE_MASTER_KEK is.
# NAVE_EVM_MASTER_KEK=

# Optional EIP-712 domain overrides (must match the deployed NaveExecution).
# NAVE_EVM_EIP712_NAME=NaveExecution
# NAVE_EVM_EIP712_VERSION=1

# Per-chain EVM RPC URLs (shared with the /relay-evm relayer + evm-indexer).
# Testnets: Sepolia (11155111), Base Sepolia (84532), Robinhood Testnet (46630).
# Mainnets: Ethereum (1), Base (8453), Robinhood Chain (4663).
# Keyed provider URLs (Alchemy/Helius etc) belong ONLY here / in the deploy
# platform's env — never in committed files. Env selects which routes are live
# via BRIDGE_EVM_LOCKBOX_<id> / BRIDGE_EVM_STAKING_<id>.
# EVM_SEPOLIA_RPC_URL=
# EVM_BASE_SEPOLIA_RPC_URL=
# EVM_ROBINHOOD_TESTNET_RPC_URL=
# EVM_ETHEREUM_RPC_URL=
# EVM_BASE_RPC_URL=
# EVM_ROBINHOOD_RPC_URL=

# ─── Cross-chain NAVE token bridge (hardened relayer) ────────────────────────
# Value moves through on-chain programs: `nave_bridge` (Solana) custodies NAVE,
# resolves the 2.5%-on-top fee split (1% staking / 1% protocol / 0.5% burn),
# and gates `release` behind pause + per-tx + daily caps + a replay guard; the
# `NaveBridge` lockbox (EVM) is the sole wNAVE minter behind the same guards.
# The relayer only holds a BOUNDED execution key (KMS/HSM on mainnet); the
# multisig owns config/caps/pause. Recipient is embedded on-chain → ONE
# signature per bridge, no off-chain recipient signature.

# Master switch — the /bridge-relay endpoint returns 503 unless this is "true".
# BRIDGE_RELAYER_ENABLED=false

# EVM network selector (mainnet | testnet). The ONLY signal used to resolve
# chain FAMILY names ('ethereum' | 'base' | 'robinhood') sent by legacy callers
# to a concrete chain id — never the Solana cluster/RPC. Unset => family-name
# input is rejected as ambiguous and callers must send numeric chain ids
# (destChainId / sourceChainId / chainId). Also the default filter for
# BRIDGE_EVM_CHAIN_IDS below. Family-name input is deprecated (one release).
# NAVE_EVM_NETWORK=testnet

# Optional explicit allow-list of EVM chain ids this relayer may serve
# (comma-separated). Default: every known chain on NAVE_EVM_NETWORK (or every
# known chain when that is unset). Chain ids outside this set are rejected
# up-front even if a lockbox is configured.
# BRIDGE_EVM_CHAIN_IDS=11155111,84532,46630

# Solana RPC for bridge verification/release (falls back to SOLANA_RPC_URL).
# BRIDGE_SOLANA_RPC_URL=

# NAVE SPL mint (base58) — the home-chain token.
# BRIDGE_SOLANA_NAVE_MINT=

# nave_bridge program id (base58). Custody + config + replay PDAs derive from it.
# BRIDGE_SOLANA_BRIDGE_PROGRAM=

# Relayer keypair secret — the on-chain BridgeConfig.relayer that signs `release`.
# KMS/HSM-backed on mainnet. Accepts JSON byte array, csv bytes, base64, base58.
# (Legacy alias BRIDGE_SOLANA_CUSTODY_AUTHORITY is still honored.)
# BRIDGE_SOLANA_RELAYER_AUTHORITY=

# Protocol-revenue NAVE token account (release fee-split: 1% protocol leg).
# BRIDGE_SOLANA_PROTOCOL_FEE_ACCOUNT=
# Owner pubkey of the protocol-revenue account (default launch wallet).
# BRIDGE_SOLANA_PROTOCOL_WALLET=6N5JiWP2zF6VXhG6hwgYEYhxBEARAV5P6WRgfYb2zskC

# Staking-leg NAVE token account (release fee-split: 1% staking leg). With the
# staking mirror enabled this should point at the neutral COLLECTOR account
# (BRIDGE_SOLANA_STAKING_COLLECTOR below), NOT the pool reward vault directly —
# the mirror then splits the collected fees across all chains by stake weight.
# The actual flip happens at deploy time alongside the on-chain
# BridgeConfig.staking_pool_account update.
# BRIDGE_SOLANA_STAKING_POOL_ACCOUNT=

# EVM relayer EOA private key (0x...). Calls the NaveBridge lockbox `bridgeIn`.
# KMS/HSM-backed on mainnet.
# BRIDGE_EVM_MINTER_PRIVATE_KEY=

# NaveBridge lockbox addresses per EVM chain (0x...) — the sole wNAVE minter.
# Hardened-stack testnet deploys (2026-07-06; same address on both chains):
# BRIDGE_EVM_LOCKBOX_11155111=0xd5695B76602A288090f3a630dfBca23912cff76d
# BRIDGE_EVM_LOCKBOX_84532=0x5Cfb00D412a4963b318e9706EB055C706B44cfF6
# Robinhood Chain Testnet (unset until the triple is deployed there):
# BRIDGE_EVM_LOCKBOX_46630=
# Mainnet (fill after hardened-bridge-<chainId>.json deploy):
# BRIDGE_EVM_LOCKBOX_1=
# BRIDGE_EVM_LOCKBOX_8453=
# BRIDGE_EVM_LOCKBOX_4663=

# WrappedNave token addresses per EVM chain (0x...) — identifies burn events.
# BRIDGE_EVM_WRAPPED_NAVE_11155111=0x1d1d988e8ffE542f1f8F7932DE3A634251D4A042
# BRIDGE_EVM_WRAPPED_NAVE_84532=0xC286e67D59F643a725cf4998af6Bb4f8D1354280
# BRIDGE_EVM_WRAPPED_NAVE_46630=
# BRIDGE_EVM_WRAPPED_NAVE_1=
# BRIDGE_EVM_WRAPPED_NAVE_8453=
# BRIDGE_EVM_WRAPPED_NAVE_4663=

# Confirmation depth required before releasing on Solana for an EVM burn (reorg
# guard) — CHAIN-AWARE. Used by both the burn verifier and the watcher.
# Per-chain safe defaults (a fixed count is ~1 min on Ethereum but ~1 s on
# Robinhood's 250 ms Nitro blocks):
#   Ethereum 1 / Sepolia 11155111 .......... 12
#   Base 8453 / Base Sepolia 84532 ......... 30
#   Robinhood 4663 / Robinhood Testnet 46630 60
# BRIDGE_EVM_CONFIRMATIONS_<chainId> is the explicit per-chain operator value
# (authoritative). The legacy global BRIDGE_EVM_CONFIRMATIONS is now only a
# FLOOR: it can deepen a chain's default but never shallow it.
# BRIDGE_EVM_CONFIRMATIONS_1=12
# BRIDGE_EVM_CONFIRMATIONS_8453=30
# BRIDGE_EVM_CONFIRMATIONS_4663=60
# BRIDGE_EVM_CONFIRMATIONS_11155111=12
# BRIDGE_EVM_CONFIRMATIONS_84532=30
# BRIDGE_EVM_CONFIRMATIONS_46630=60
# BRIDGE_EVM_CONFIRMATIONS=            # legacy global floor (unset = chain defaults)

# Total fee in basis points, charged ON TOP (default 250 = 2.5%). Must match the
# app's VITE_NAVE_BRIDGE_FEE_BPS and the on-chain BridgeConfig.
# BRIDGE_FEE_BPS=250

# Internal source-chain id stamped on Solana→EVM mints (lockbox replay key).
# BRIDGE_SOLANA_SRC_CHAIN_ID=900

# ─── Staking global-parity mirror (worker tick) ──────────────────────────────
# Splits the bridge's 1% staking-fee leg (accumulating as NAVE in a neutral
# relayer-owned collector account) across the Solana nave_staking pool and each
# EVM NaveStaking by live stake weight, so the drip APY converges globally.
# Reuses BRIDGE_SOLANA_RELAYER_AUTHORITY (collector owner), the lockbox/wNAVE
# addresses, BRIDGE_EVM_MINTER_PRIVATE_KEY (lockbox relayer AND the staking
# `rewarder`), and the per-chain EVM_*_RPC_URL endpoints above.

# Master switch — the worker tick is a silent no-op unless this is "true".
# STAKING_MIRROR_ENABLED=false

# Neutral relayer-owned NAVE token account receiving the bridge's 1% staking
# leg (what BRIDGE_SOLANA_STAKING_POOL_ACCOUNT should point at post-cutover).
# BRIDGE_SOLANA_STAKING_COLLECTOR=

# nave_staking program id (pool / reward-vault PDAs derive from it).
# BRIDGE_SOLANA_STAKING_PROGRAM=AxVdBgc8eUZ3VXKCCJxF7mAmRAtvtM2eYAbE3XBjnhjf

# NaveStaking (drip pool) addresses per EVM chain — relayer EOA must be the
# on-chain `rewarder`. (Drip redeploy 2026-07-06; the pre-drip pool was
# 0x72939965d3ebb3D13be7C853B6DB6B19150c35b3 on both chains.)
# BRIDGE_EVM_STAKING_11155111=0x9BdE2F925fb71bDfC3EA0F0F9617786b5a642F02
# BRIDGE_EVM_STAKING_84532=0x7860FF876b49a5A992a7F3a4a6043ea57f17eD96
# BRIDGE_EVM_STAKING_46630=
# BRIDGE_EVM_STAKING_1=
# BRIDGE_EVM_STAKING_8453=
# BRIDGE_EVM_STAKING_4663=

# Minimum collector balance (base units, 6 decimals) before distributing.
# Below it the tick only sends a permissionless `sync` poke. Default 1 NAVE.
# STAKING_MIRROR_MIN_RAW=1000000

# Lockbox srcChainId reserved for staking-mirror wNAVE mints (replay-key
# partition; MUST differ from BRIDGE_SOLANA_SRC_CHAIN_ID=900). Default 901.
# STAKING_MIRROR_SRC_CHAIN_ID=901

# Worker cadence + audit-mirror lookback window.
# STAKING_MIRROR_INTERVAL_MS=600000
# STAKING_MIRROR_EVM_LOOKBACK_BLOCKS=5000

# ─── EVM claim-on-demand rewards (stakeClaims.ts) ────────────────────────────
# EVM stakers earn a pro-rata share of the ONE Solana reward pool; the relayer
# keeps the authoritative accrual in Supabase (evm_reward_accounts) and wraps +
# mints wNAVE straight to the staker when they claim (/stake-claim). When
# enabled, the mirror parks EVM fee shares in the reserve below instead of
# pre-funding the per-chain drip contracts.

# Master switch for /stake-claim, /stake-claim/pending and the accrual tick.
# STAKE_CLAIM_ENABLED=false

# Relayer-owned Solana NAVE token account backing EVM reward payouts (the
# mirror moves each tick's combined EVM share here; claims draw from it).
# STAKE_CLAIM_RESERVE=

# Lockbox srcChainId partition for claim mints (MUST differ from the bridge's
# 900 and the mirror's 901). Default 902.
# STAKE_CLAIM_SRC_CHAIN_ID=902

# Optional per-claim payout cap in base units (0/unset = uncapped; the reserve
# balance always caps regardless).
# STAKE_CLAIM_MAX_RAW=

# ─── Independent bridge watcher (worker tick, audit M-1) ─────────────────────
# Recovers relays that the push-based /bridge-relay path missed or that failed
# transiently. Two passes: (1) re-drive stale pending/failed transfers through
# the verified relay path, bounded by retry_count; (2) optionally scan the
# chains for BridgeLock/BridgeBurnTo events with no bridge_transfers row.
# Reuses ALL the BRIDGE_* config above; on-chain replay guards remain the
# authoritative double-spend protection, so a re-drive is always safe.

# Master switch — the worker tick is a silent no-op unless this is "true".
# BRIDGE_WATCHER_ENABLED=false

# How long a transfer must be idle before the retry sweep touches it (ms).
# BRIDGE_WATCHER_STALE_MS=600000

# Max automatic re-executions before a transfer is parked as status 'stuck'.
# BRIDGE_WATCHER_MAX_RETRIES=5

# Rows considered per sweep.
# BRIDGE_WATCHER_BATCH_SIZE=25

# Enable the missed-event chain scan (in addition to the retry sweep).
# BRIDGE_WATCHER_SCAN_EVENTS=false

# Scan lookback window for the missed-event pass, in SECONDS (default 7200 =
# 2 h). Converted to blocks PER CHAIN using each chain's block time (Ethereum
# 12 s, Base 2 s, Robinhood 0.25 s), so the window is uniform in wall-clock
# time across chains.
# BRIDGE_LOOKBACK_SECONDS=7200
# Legacy floor in blocks (optional). When set, the per-chain block window is
# max(seconds→blocks, this value).
# BRIDGE_WATCHER_EVM_LOOKBACK_BLOCKS=
# BRIDGE_WATCHER_SOLANA_SIG_LIMIT=100

# Worker cadence for the watcher tick.
# BRIDGE_WATCHER_INTERVAL_MS=300000
