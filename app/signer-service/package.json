{
  "name": "nave-signer-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js relayer that decrypts Nave AI-agent keys and submits on-chain approval/halt/execution transactions via the Anchor client.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test-force-exit --import tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@pythnetwork/hermes-client": "^2.0.0",
    "@pythnetwork/pyth-solana-receiver": "^0.12.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "^2.57.4",
    "@upstash/redis": "^1.38.0",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@solana/web3.js": "1.98.4",
    "rpc-websockets": "9.3.9"
  }
}
