# =============================================================================
# Nave mainnet cutover — BRIDGE + STAKE ONLY
# =============================================================================
#
# Copy to a PRIVATE path (never commit real secrets), then:
#
#   npm run mainnet:cutover -- --env <path> --key-dir <path> \
#     --phase preflight --scope bridge-stake --confirm-mainnet
#
# Default scope is bridge-stake (nave_bridge + nave_staking + EVM hardened
# bridge stack). Treasury / DAO programs stay on devnet until --scope full.
#
# Fill REPLACE_* placeholders. Anything with SECRET / KEY / TOKEN / KEK /
# PRIVATE_KEY is sensitive. See docs/MAINNET_PREFLIGHT.md.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Scope + Solana deploy
# -----------------------------------------------------------------------------

CUTOVER_SCOPE=bridge-stake

# Paid Solana mainnet RPC (must resolve to mainnet-beta genesis).
MAINNET_RPC_URL=https://your-mainnet-rpc.example/?api-key=REPLACE_ME

# Deploy / upgrade-authority keypair path (solana CLI signs with this).
DEPLOY_WALLET_PATH=/secure/path/nave-mainnet-deploy-wallet.json

# Solana admin pubkey for upgrade authority + BridgeConfig/StakePool owner.
# Can be Squads vault OR a cold Ledger pubkey. MUST differ from the relayer.
SQUADS_VAULT=REPLACE_WITH_ADMIN_PUBKEY


# -----------------------------------------------------------------------------
# 2. Cluster + safety switches
# -----------------------------------------------------------------------------

NAVE_CLUSTER=mainnet
VITE_USE_MOCKS=false
FAUCET_ENABLED=false
# Reverse-proxy hops the signer trusts for X-Forwarded-For (Railway = 1).
TRUSTED_PROXY_HOPS=1


# -----------------------------------------------------------------------------
# 3. Supabase (production project)
# -----------------------------------------------------------------------------

SUPABASE_PROJECT_REF=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY


# -----------------------------------------------------------------------------
# 4. Helius + Upstash (signer fail-closes without Redis on mainnet)
# -----------------------------------------------------------------------------

HELIUS_API_KEY=your-helius-api-key

UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN


# -----------------------------------------------------------------------------
# 5. Signer service
# -----------------------------------------------------------------------------

NAVE_SIGNER_URL=https://your-signer.example.com
NAVE_ALLOWED_ORIGINS=https://app.yourdomain.com

# Distinct secrets (>= 32 chars each; must differ).
NAVE_SIGNER_SECRET=your-nave-signer-secret
NAVE_INDEXER_SECRET=your-nave-indexer-secret

# Master KEK wrapping server-custodied keys (>= 40 chars; base64 32 bytes).
NAVE_MASTER_KEK=REPLACE_WITH_MASTER_KEK_BASE64

# Keep simulation ON on mainnet.
NAVE_SIGNER_SKIP_SIMULATION=false


# -----------------------------------------------------------------------------
# 6. EVM deploy (Safe owns contracts; deploy wallet only broadcasts)
# -----------------------------------------------------------------------------
#
# Leave VITE_EVM_NETWORK commented until at least one chain's bridge triple
# (section 7) is filled — otherwise preflight refuses an empty EVM config.
# After deploy, set:
# VITE_EVM_NETWORK=mainnet

# Safe multisig — owner of WrappedNave / NaveBridge / NaveStaking on each chain.
SAFE_ADDRESS=0xd338C8d0C3e28979D1cFec2f7C66769C796db89c

# ONE OF: private key OR foundry keystore account (prefer keystore).
# EVM_DEPLOY_PRIVATE_KEY=0xREPLACE
# EVM_DEPLOY_ACCOUNT=nave-deployer

# Server RPCs (keyed Alchemy/etc. OK — never put these in VITE_*).
EVM_ETHEREUM_RPC_URL=https://eth-mainnet.example/REPLACE
EVM_BASE_RPC_URL=https://base-mainnet.example/REPLACE
EVM_ROBINHOOD_RPC_URL=https://robinhood-mainnet.example/REPLACE

# Explorer verify keys (Robinhood/Blockscout needs no key).
ETHERSCAN_API_KEY=your-etherscan-api-key
BASESCAN_API_KEY=your-basescan-api-key

# Optional: single-chain RPC alias used by evm-mainnet-cutover per --chain-id.
# EVM_RPC_URL=https://eth-mainnet.example/REPLACE


# -----------------------------------------------------------------------------
# 7. App frontend (Vercel) — bridge / stake UI
# -----------------------------------------------------------------------------

# Public browser RPCs only (no API keys in the bundle).
VITE_EVM_ETHEREUM_RPC_URL=https://eth.llamarpc.com
VITE_EVM_BASE_RPC_URL=https://mainnet.base.org
VITE_EVM_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

VITE_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_WALLETCONNECT_PROJECT_ID

# Canonical mainnet NAVE mint (fixed supply).
VITE_SOLANA_NAVE_MINT=EGg56E1YtL5YapzkF7vkRThHR8i5FeRvm2LLuySdYory

# Filled after Solana deploy (or merged from deployments/mainnet-program-ids.env).
# VITE_NAVE_BRIDGE_PROGRAM_ID=REPLACE
# VITE_NAVE_STAKING_PROGRAM_ID=REPLACE

VITE_NAVE_BRIDGE_RELAYER_URL=https://your-signer.example.com
# VITE_NAVE_BRIDGE_SOLANA_CUSTODY=REPLACE_WITH_CUSTODY_TOKEN_ACCOUNT
VITE_NAVE_BRIDGE_FEE_BPS=250
# VITE_NAVE_BRIDGE_STAKING_POOL_ACCOUNT=REPLACE_WITH_COLLECTOR_TOKEN_ACCOUNT
# VITE_NAVE_BRIDGE_PROTOCOL_FEE_ACCOUNT=REPLACE_WITH_PROTOCOL_FEE_TOKEN_ACCOUNT

# Per-chain triples — fill after EVM deploy (match hardened-bridge-<chainId>.json).
# Do not point these at hardened-bridge-unused-parallel-wnave-*.json or
# evm-launch-8453.json (status do-not-wire).
#
# Yield-sister cutover (Robinhood WETH → Ethereum sister treasury) requires
# real chain-1 DAO addresses. deployments/1.json is an Anvil fixture and is
# not that stack. Leave the protocol/factory unset until a Safe-owned deploy
# writes a production 1.json.
# VITE_EVM_ETHEREUM_PROTOCOL_ADDRESS=0xREPLACE
# VITE_EVM_ETHEREUM_FACTORY_ADDRESS=0xREPLACE
# VITE_EVM_ROBINHOOD_ARBITRUM_BRIDGE_ADAPTER_ADDRESS=0xREPLACE
#
# Base Balancer is 0x0 in adapters-8453.json (offerInUi false). Curve is
# dormant (no address). Do not set either.
#
# Ethereum (1)
# VITE_EVM_ETHEREUM_WRAPPED_NAVE_ADDRESS=0xREPLACE
# VITE_EVM_ETHEREUM_BRIDGE_LOCKBOX_ADDRESS=0xREPLACE
# VITE_EVM_ETHEREUM_STAKING_ADDRESS=0xREPLACE

# Base (8453)
# VITE_EVM_BASE_WRAPPED_NAVE_ADDRESS=0xREPLACE
# VITE_EVM_BASE_BRIDGE_LOCKBOX_ADDRESS=0xREPLACE
# VITE_EVM_BASE_STAKING_ADDRESS=0xREPLACE

# Robinhood (4663)
# VITE_EVM_ROBINHOOD_WRAPPED_NAVE_ADDRESS=0xREPLACE
# VITE_EVM_ROBINHOOD_BRIDGE_LOCKBOX_ADDRESS=0xREPLACE
# VITE_EVM_ROBINHOOD_STAKING_ADDRESS=0xREPLACE


# -----------------------------------------------------------------------------
# 8. Bridge relayer + staking mirror + watcher (Railway signer / worker)
# -----------------------------------------------------------------------------
#
# Set NAVE_BRIDGE_MAINNET_REVIEWED=true only after final review (P1 split,
# KMS/HSM relayer keys, caps, smoke). Cutover refuses BRIDGE_* without it.

NAVE_BRIDGE_MAINNET_REVIEWED=true

# Start false; flip true after deploy + smoke + unpause.
BRIDGE_RELAYER_ENABLED=false
STAKING_MIRROR_ENABLED=false
BRIDGE_WATCHER_ENABLED=false
STAKE_CLAIM_ENABLED=false

BRIDGE_SOLANA_RPC_URL=https://your-mainnet-rpc.example/?api-key=REPLACE_ME
BRIDGE_SOLANA_NAVE_MINT=EGg56E1YtL5YapzkF7vkRThHR8i5FeRvm2LLuySdYory

# Filled only after a NEW nave_bridge / nave_staking deploy.
# The previous mainnet ids are closed and must not be reused:
#   nave_bridge  Fu3ZpX1SMvqVhuo7E4uKGvJxe6cJDFDxxmSCET6de9u6
#   nave_staking AxVdBgc8eUZ3VXKCCJxF7mAmRAtvtM2eYAbE3XBjnhjf
# If any BRIDGE_* / VITE_NAVE_*_PROGRAM_ID var above is set, preflight
# refuses while the bridge program id is missing or that account is not executable.
# BRIDGE_SOLANA_BRIDGE_PROGRAM=REPLACE
# BRIDGE_SOLANA_STAKING_PROGRAM=REPLACE

# Hot relayer (KMS/HSM preferred). MUST differ from SQUADS_VAULT / SAFE_ADDRESS.
# BRIDGE_SOLANA_RELAYER_AUTHORITY=REPLACE_WITH_RELAYER_KEYPAIR_SECRET
# BRIDGE_SOLANA_RELAYER_PUBKEY=REPLACE_WITH_RELAYER_PUBKEY
# BRIDGE_EVM_MINTER_PRIVATE_KEY=REPLACE_WITH_EVM_RELAYER_KEY
# BRIDGE_EVM_RELAYER_ADDRESS=0xREPLACE

# Token accounts (create before go-live).
# BRIDGE_SOLANA_PROTOCOL_FEE_ACCOUNT=REPLACE
# BRIDGE_SOLANA_PROTOCOL_WALLET=REPLACE_WITH_PROTOCOL_FEE_OWNER_PUBKEY
# With mirror on: POOL_ACCOUNT must equal COLLECTOR (neutral relayer-owned account).
# BRIDGE_SOLANA_STAKING_COLLECTOR=REPLACE
# BRIDGE_SOLANA_STAKING_POOL_ACCOUNT=REPLACE

BRIDGE_FEE_BPS=250
# Relayer EVM network selector — the ONLY source for 'base'|'robinhood'|'ethereum'
# route-name resolution (the Solana cluster is no longer consulted).
NAVE_EVM_NETWORK=mainnet
# Optional allow-list of chain ids the relayer serves (default: all mainnet).
# BRIDGE_EVM_CHAIN_IDS=1,8453,4663
# Chain-aware finality. Per-chain values are authoritative; the cutover refuses
# anything below the defaults (1: 12, 8453: 30, 4663: 60).
BRIDGE_EVM_CONFIRMATIONS_1=12
BRIDGE_EVM_CONFIRMATIONS_8453=30
BRIDGE_EVM_CONFIRMATIONS_4663=60
# BRIDGE_EVM_CONFIRMATIONS is now only an optional global floor (deepen-only).
# Missed-event scan window in seconds (converted to blocks per chain; >= 3600).
BRIDGE_LOOKBACK_SECONDS=7200
BRIDGE_SOLANA_SRC_CHAIN_ID=900

# Lockboxes + staking (match VITE triples / hardened-bridge-*.json).
# BRIDGE_EVM_LOCKBOX_1=0xREPLACE
# BRIDGE_EVM_LOCKBOX_8453=0xREPLACE
# BRIDGE_EVM_LOCKBOX_4663=0xREPLACE
# BRIDGE_EVM_STAKING_1=0xREPLACE
# BRIDGE_EVM_STAKING_8453=0xREPLACE
# BRIDGE_EVM_STAKING_4663=0xREPLACE

# Mirror (enable with STAKING_MIRROR_ENABLED=true).
STAKING_MIRROR_SRC_CHAIN_ID=901
STAKING_MIRROR_MIN_RAW=1000000
STAKING_MIRROR_INTERVAL_MS=600000

# Claim-on-demand (needs mirror + dedicated reserve account, not wallet ATA).
# STAKE_CLAIM_RESERVE=REPLACE
STAKE_CLAIM_SRC_CHAIN_ID=902
STAKE_CLAIM_MIN_RAW=1000000

# Watcher retries.
BRIDGE_WATCHER_STALE_MS=600000
BRIDGE_WATCHER_MAX_RETRIES=5
BRIDGE_WATCHER_BATCH_SIZE=25
BRIDGE_WATCHER_INTERVAL_MS=300000


# -----------------------------------------------------------------------------
# 9. EVM indexer (Railway) — optional tunables
# -----------------------------------------------------------------------------

# EVM_LOG_CHUNK_BLOCKS=2000
# EVM_INDEXER_POLL_MS=15000
# EVM_CONFIRMATIONS=5
# EVM_FINALITY_TAG=finalized


# =============================================================================
# FULL DAO / TREASURY CUTOVER (--scope full) — not needed for bridge+stake
# =============================================================================
# Uncomment when you later cut over nave_core and the DAO stack.
#
# NAVE_AGENT_SECRET=REPLACE_WITH_UNIQUE_AGENT_SECRET_32PLUS
# ANTHROPIC_API_KEY=REPLACE
# VITE_ESCROW_PDA_ENABLED=true
# NAVE_ESCROW_PDA_ENABLED=true
# VITE_NAVE_PROTOCOL_FEE_WALLET=REPLACE_FUNDED_MAINNET_PUBKEY
# JUPITER_LENDING_PROGRAM_ID=jup3YeL8QhtSx1e253b2FDvsMNC87fDrgQZivbrndc9
# JUPITER_LIQUIDITY_PROGRAM_ID=jupeiUmn818Jg1ekPURTpr4mFo29p46vygyykFJ3wZC
# VITE_MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPYctwafyhdvnV7FZnsebVacA
# MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPYctwafyhdvnV7FZnsebVacA
# NAVE_MAX_NAV_AGE_SECONDS=900
# NAVE_VAULT_LAST_REVALUED_OFF=130
# NAVE_REVALUE_TREASURY_KEEPER_CONFIRMED=passed
# NAVE_GUARDRAILS_FAIL_CLOSED=true
#
# Agent LLM guardrails (edge functions).
# LLM_TIMEOUT_MS=60000
# LLM_DAILY_TOKEN_BUDGET=2000000
# NAVE_EXECUTION_GRACE_SECS=86400
# NAVE_ORACLE_PERSIST_TTL_SECONDS=60
# Operator-only raw-DEK export gate — leave UNSET unless an incident runbook needs it.
# NAVE_BREAK_GLASS_SECRET=REPLACE_32PLUS_RANDOM
# NAVE_AUTOPROPOSE_ENABLED=false
#
# VITE_EVM_*_FACTORY_ADDRESS / PROTOCOL / adapters + EVM_RELEASE_GATE_* …
# =============================================================================
