# EVM testnet live E2E (copy to .env.testnet.local — gitignored)
#
# Required for live TestnetE2E (set EVM_TESTNET_LIVE=1 to enable broadcast)
EVM_TESTNET_LIVE=0
EVM_TESTNET_RPC_URL=https://sepolia.drpc.org
EVM_TESTNET_CHAIN_ID=11155111

# Private key (0x-prefixed hex) OR wallet JSON path:
# EVM_DEPLOY_PRIVATE_KEY=0x...
EVM_DEPLOY_WALLET_JSON=evm-deploy-wallet.json

# Optional explicit adapter override (defaults from deployments/adapters-{chainId}.json)
# AAVE_V3_ADAPTER=0x...
