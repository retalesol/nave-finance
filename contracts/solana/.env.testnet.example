# Devnet / testnet contract tests (copy to .env.testnet.local — gitignored)
#
# Solana devnet
SOLANA_DEVNET_RPC=https://your-devnet-rpc.example
# Optional: explicit WebSocket URL (defaults to https→wss on same host)
# SOLANA_DEVNET_WS=wss://your-devnet-rpc.example
ANCHOR_WALLET=.deploy-wallet-devnet.json

# EVM testnets (used by run-evm-testnet-suite.mjs)
# EVM_TESTNET_RPC_URL=https://sepolia.drpc.org
# EVM_TESTNET_CHAIN_ID=11155111
# EVM_DEPLOY_PRIVATE_KEY=0x...
# Or point at the repo wallet file (runner reads bytes → hex):
# EVM_DEPLOY_WALLET_JSON=../evm/evm-deploy-wallet.json

# Optional overrides
# NAVE_CORE_PROGRAM_ID=8GSh9ghC2EL88X9FwftiH2QDrm8drvgSLAUoo45gN5nB

# NAVE staking / bridge test assets
SOLANA_NAVE_MAINNET_MINT=EGg56E1YtL5YapzkF7vkRThHR8i5FeRvm2LLuySdYory
SOLANA_NAVE_DEVNET_MINT=GmBMZuXsXpe7TZK27PTcXUyNGcuw9Ew8v3fxys7wM9Wa
NAVE_DEVNET_PRICE_USD=10
NAVE_DAO_CREATION_STAKE_USD=99

# Wormhole NTT / Executor validation defaults. Executor FeeArgs uses tenths of
# basis points (`dbps`), so 2% = 200 bps = 2000 dbps.
NAVE_BRIDGE_FEE_BPS=200
NAVE_BRIDGE_FEE_DBPS=2000
# NAVE_BRIDGE_REFERRER_FEE_PAYEE_EVM=0x...
