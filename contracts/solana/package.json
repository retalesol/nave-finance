{
  "name": "nave-solana-tests",
  "private": true,
  "scripts": {
    "test:unit": "../node_modules/.bin/ts-mocha -p ./tsconfig.json -t 120000 tests/governance-quorum-scenarios.ts tests/treasury-apy-scenarios.ts tests/scenario-simulation.ts",
    "test:localnet": "anchor test",
    "test": "anchor test",
    "mainnet:cutover": "node scripts/mainnet-cutover.mjs",
    "mainnet:wizard": "node \"${NAVE_APP_DIR:-../../app}/scripts/mainnet-cutover-wizard.mjs\" --dry-run",
    "mainnet:cutover:evm": "node scripts/evm-mainnet-cutover.mjs",
    "mainnet:cutover:evm:preflight": "node scripts/evm-mainnet-cutover.mjs --phase preflight",
    "mainnet:cutover:evm:adapters": "node scripts/evm-mainnet-cutover.mjs --phase adapters",
    "mainnet:cutover:evm:handoff": "node scripts/evm-mainnet-cutover.mjs --phase handoff",
    "mainnet:cutover:evm:verify": "node scripts/evm-mainnet-cutover.mjs --phase verify",
    "test:manifest": "node scripts/generate-test-manifest.mjs",
    "localnet:up": "bash scripts/localnet-session.sh up",
    "localnet:down": "bash scripts/localnet-session.sh down",
    "localnet:status": "bash scripts/localnet-session.sh status",
    "test:checkpoint": "node scripts/checkpoint-runner.mjs run",
    "test:resume": "node scripts/checkpoint-runner.mjs resume",
    "test:checkpoint:status": "node scripts/checkpoint-runner.mjs status",
    "test:checkpoint:reset": "node scripts/checkpoint-runner.mjs reset",
    "test:checkpoint:full": "npm run test:checkpoint:reset && npm run test:manifest && npm run test:checkpoint",
    "test:devnet:solana:smoke": "node scripts/run-devnet-suite.mjs --tier smoke",
    "test:devnet:solana:full": "node scripts/run-devnet-suite.mjs --tier full",
    "test:devnet:evm": "node scripts/run-evm-testnet-suite.mjs",
    "test:devnet:evm:live": "node scripts/run-evm-testnet-suite.mjs --live",
    "bridge:validate-fee": "node scripts/validate-ntt-fee-config.mjs",
    "bridge:setup": "node scripts/bridge-setup-relayer.mjs",
    "bridge:setup:dry": "node scripts/bridge-setup-relayer.mjs --dry-run",
    "bridge:smoke:devnet": "node scripts/bridge-smoke-devnet.mjs --wallet .deploy-wallet-devnet.json",
    "staking:smoke:devnet": "node scripts/staking-smoke-devnet.mjs --wallet .deploy-wallet-devnet.json",
    "smoke:devnet": "npm run bridge:smoke:devnet && npm run staking:smoke:devnet",
    "reclaim:buffers": "bash scripts/reclaim-upgrade-buffers.sh",
    "reclaim:buffers:close-all": "bash scripts/reclaim-upgrade-buffers.sh --close-all"
  }
}
